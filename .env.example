# Postgres connection string (Vercel → Storage → Neon creates DATABASE_URL for you)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string used to sign login sessions (at least 32 characters)
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# First SuperAdmin account, created automatically when the users table is empty
ADMIN_PHONE=+998901234567
ADMIN_PASSWORD=ChangeMe123

# Vercel Cron sends this as a Bearer token to /api/cron/forward
CRON_SECRET=another-long-random-string

# Vodokanal API (leave empty until you receive their documentation; forwarding stays paused)
VODOKANAL_API_URL=
VODOKANAL_API_KEY=
